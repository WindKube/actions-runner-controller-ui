# Keep the build context to what the image actually needs: Go sources, .templ
# sources and assets/input.css. Everything below is either regenerated inside
# the image or irrelevant to it.
#
# Docker resolves .dockerignore against the BUILD CONTEXT ROOT, which for every
# build of this image is the repository root — so this is the file that applies.
.git
.github
.gitignore
.golangci.yml
.testcoverage.yml
Taskfile.yaml
compose.yaml
chart
docs
README.md
*.md

# Claude Code state, including git worktrees under .claude/worktrees. Without
# this, a context rooted here recurses into a full second copy of the repo.
.claude

# Local build artefacts. Shipping a host-built binary or a stale generated file
# into the context would shadow what the generate stage produces.
/arc-ui
.bin/
*_templ.go
internal/web/static/app.css
*.db
*.db-wal
*.db-shm

.env
.env.*
.DS_Store
.idea/
.vscode/
