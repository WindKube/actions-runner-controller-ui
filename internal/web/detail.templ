package web

import (
	"fmt"
	"time"

	"arc-ui/internal/fleet"
)

// SetPage is the RunnerSet detail view.
templ SetPage(d SetDetail) {
	<div class="py-3 flex flex-wrap items-center gap-3">
		<h1 class="text-[15px] font-semibold text-fg font-mono">{ d.Set.Name }</h1>
		@Pill(SetTone(d.Set), SetBadge(d.Set))
		if d.Set.Phase != "" {
			<span class="text-[11px] text-fg-subtle font-mono">phase { d.Set.Phase }</span>
		}
		<div class="flex-1"></div>
		<a
			href={ templ.SafeURL("/?set=" + d.Set.Name) }
			class="h-[28px] inline-flex items-center px-2.5 rounded-md border border-default text-[11px] text-fg-muted hover:text-fg hover:bg-inset"
		>filter fleet to this set</a>
	</div>
	@SetTiles(d)
	<div class="mt-3 grid gap-3 grid-cols-1 xl:grid-cols-3">
		<div class="xl:col-span-2 grid gap-3 content-start">
			@SetHistory(d)
			@SetResources(d)
			@SetChurn(d)
		</div>
		@SetConfig(d)
	</div>
	<div class="mt-3">
		@SetRunners(d)
	</div>
}

// SetTiles is the KPI strip for one set.
templ SetTiles(d SetDetail) {
	<section id="tiles" class="grid gap-3 grid-cols-2 xl:grid-cols-4">
		for _, t := range d.Tiles {
			@TileCard(t)
		}
	</section>
}

// TileCard is one KPI box, shared by every view's tile strip.
templ TileCard(t Tile) {
	<div class="rounded-md border border-default bg-raised px-3.5 py-3">
		<div class="text-[10.5px] uppercase tracking-[0.4px] text-fg-subtle">{ t.Label }</div>
		<div class={ "mt-1 text-[22px] leading-none font-semibold tabular-nums", t.Tone.Text() }>{ t.Value }</div>
		<div class="mt-1.5 text-[11px] text-fg-subtle truncate" title={ t.Sub }>{ t.Sub }</div>
		if t.Total > 0 {
			@MicroBar(t.Tone, t.Bar, t.Total)
		}
	</div>
}

// SetHistory is the stacked runner-count chart for one set.
templ SetHistory(d SetDetail) {
	@Card("history", "runners over time", d.Range.Label()) {
		@AreaChartView(d.History)
	}
}

// SetResources stacks the set's CPU and memory charts.
templ SetResources(d SetDetail) {
	@Card("resources", "resource usage", d.Range.Label()) {
		@ResourcePair(d.CPU, d.Mem)
	}
}

// ResourcePair is the CPU-over-memory layout used by every resource panel.
templ ResourcePair(cpu, mem LineChart) {
	<div class="space-y-4">
		<div>
			<div class="text-[11px] text-fg-subtle mb-1.5">cpu · cores</div>
			@LineChartView(cpu)
		</div>
		<div>
			<div class="text-[11px] text-fg-subtle mb-1.5">memory</div>
			@LineChartView(mem)
		</div>
	</div>
}

// SetChurn is runner creation against termination for one set.
templ SetChurn(d SetDetail) {
	@Card("churn", "runner churn", d.Range.Label()) {
		@ChurnChartView(d.Churn)
	}
}

// SetConfig is the set's declared configuration.
templ SetConfig(d SetDetail) {
	@Card("config", "configuration", "") {
		<div class="-my-1.5">
			for _, kv := range d.Config {
				@KVRow(kv)
			}
		</div>
	}
}

// SetRunners is the runner table scoped to one set.
templ SetRunners(d SetDetail) {
	@Card("runners", "runners in this set", fmt.Sprintf("%d", len(d.Runners))) {
		if len(d.Runners) == 0 {
			@Empty("this set currently has no runners")
		} else {
			@RunnerTable(d.Runners, d.Now)
		}
	}
}

// RunnerTable is the shared runner listing.
templ RunnerTable(runners []fleet.Runner, now time.Time) {
	<div class="overflow-x-auto -mx-3.5 -my-3.5">
		<table class="w-full min-w-[820px] text-[12px] border-collapse">
			<thead>
				<tr class="border-b border-default text-[10.5px] uppercase tracking-[0.4px] text-fg-subtle">
					<th class="text-left font-semibold px-3.5 py-2">runner</th>
					<th class="text-left font-semibold px-3.5 py-2">state</th>
					<th class="text-left font-semibold px-3.5 py-2">job</th>
					<th class="text-right font-semibold px-3.5 py-2">cpu</th>
					<th class="text-right font-semibold px-3.5 py-2">memory</th>
					<th class="text-right font-semibold px-3.5 py-2">age</th>
				</tr>
			</thead>
			<tbody>
				for _, r := range runners {
					@RunnerRow(r, now)
				}
			</tbody>
		</table>
	</div>
}

// RunnerPage is the single-runner detail view.
templ RunnerPage(d RunnerDetail) {
	<div class="py-3 flex flex-wrap items-center gap-3">
		<h1 class="text-[15px] font-semibold text-fg font-mono">{ d.Runner.Name }</h1>
		@StatePill(d.Runner.State)
		<div class="flex-1"></div>
		<a
			href={ templ.SafeURL("/runnersets/" + d.Runner.SetName) }
			class="h-[28px] inline-flex items-center px-2.5 rounded-md border border-default text-[11px] text-fg-muted hover:text-fg hover:bg-inset"
		>open runnerset</a>
	</div>
	<div class="grid gap-3 grid-cols-1 xl:grid-cols-3">
		<div class="xl:col-span-2 grid gap-3 content-start">
			@RunnerResources(d)
			@RunnerEvents(d)
			@SetJobsPanel(d)
		</div>
		@RunnerFacts(d)
	</div>
}

// RunnerResources is the raw per-runner usage over the last few minutes.
//
// The window is fixed rather than following the page's range selector: raw
// per-runner samples are retained for minutes, so a 30-day range would render
// a handful of points crammed against the right edge.
templ RunnerResources(d RunnerDetail) {
	@Card("resources", "resource usage", "last 4 minutes") {
		@ResourcePair(d.CPU, d.Mem)
	}
}

// RunnerEvents lists the pod's kubelet and scheduler events.
templ RunnerEvents(d RunnerDetail) {
	@Card("events", "pod events", "") {
		if len(d.Events) == 0 {
			@Empty("no recent events — Kubernetes expires these after about an hour")
		} else {
			<ul class="space-y-2.5">
				for _, e := range d.Events {
					<li class="flex items-start gap-2">
						@Dot(eventTone(e))
						<div class="min-w-0 flex-1">
							<div class="flex items-baseline gap-2">
								<span class="font-mono text-[11.5px] text-fg">{ e.Reason }</span>
								if e.Count > 1 {
									<span class="text-[10.5px] text-fg-subtle font-mono">×{ fmt.Sprint(e.Count) }</span>
								}
							</div>
							<div class="text-[11px] text-fg-muted break-words">{ e.Message }</div>
						</div>
						<span class="text-[10.5px] text-fg-subtle font-mono shrink-0">{ fleet.FormatRelative(e.At, d.Now) }</span>
					</li>
				}
			</ul>
		}
	}
}

// RunnerFacts is the identity and lifecycle panel.
templ RunnerFacts(d RunnerDetail) {
	@Card("facts", "runner", "") {
		<div class="-my-1.5">
			for _, kv := range d.Facts {
				@KVRow(kv)
			}
		</div>
	}
}

// SetJobsPanel lists what the rest of the RunnerSet is working on.
//
// The design showed a job history for the individual runner. That panel cannot
// exist here: an ARC ephemeral runner accepts exactly one job and then
// terminates, so its history is always a single row. Widening the scope to the
// RunnerSet keeps the panel's purpose — what is this pool actually doing —
// while telling the truth about the lifecycle.
templ SetJobsPanel(d RunnerDetail) {
	@Card("setjobs", "jobs across "+d.Runner.SetName, fmt.Sprintf("%d", len(d.SetJobs))) {
		if len(d.SetJobs) == 0 {
			@Empty("no runner in this set is executing a job")
		} else {
			<div class="overflow-x-auto -mx-3.5 -my-3.5">
				<table class="w-full min-w-[640px] text-[12px] border-collapse">
					<thead>
						<tr class="border-b border-default text-[10.5px] uppercase tracking-[0.4px] text-fg-subtle">
							<th class="text-left font-semibold px-3.5 py-2">runner</th>
							<th class="text-left font-semibold px-3.5 py-2">repository</th>
							<th class="text-left font-semibold px-3.5 py-2">job</th>
							<th class="text-right font-semibold px-3.5 py-2">running</th>
						</tr>
					</thead>
					<tbody>
						for _, j := range d.SetJobs {
							<tr
								class={ "border-b border-muted last:border-0",
									templ.KV("bg-accent/10", j.Current),
									templ.KV("hover:bg-inset/60", !j.Current) }
							>
								<td class="px-3.5 py-2">
									<a href={ templ.SafeURL("/runners/" + j.Runner) } class="font-mono hover:underline">
										{ j.Runner }
									</a>
									if j.Current {
										<span class="ml-1.5 text-[10px] text-accent">this runner</span>
									}
								</td>
								<td class="px-3.5 py-2 font-mono truncate max-w-[200px]">{ Dash(j.Repository) }</td>
								<td class="px-3.5 py-2 truncate max-w-[220px]">{ Dash(j.Workflow) } · { Dash(j.Job) }</td>
								<td class="px-3.5 py-2 text-right font-mono tabular-nums text-fg-subtle">{ j.Age }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

// NotFound is the page shown when a runner or set is no longer in the fleet,
// which on an ephemeral fleet is a routine outcome rather than an error.
templ NotFound(p Page, kind, name string) {
	<div class="py-16 text-center">
		<div class="text-[13px] text-fg">
			no { kind } named <span class="font-mono text-fg-body">{ name }</span>
		</div>
		<p class="mt-2 text-[11.5px] text-fg-subtle max-w-md mx-auto">
			Runners are ephemeral: this one has most likely finished its job and been
			removed. Historical charts remain available from the fleet view.
		</p>
		<a href="/" class="inline-flex mt-4 h-[28px] items-center px-3 rounded-md border border-default text-[11.5px] text-fg-muted hover:text-fg hover:bg-inset">back to fleet</a>
	</div>
}

func eventTone(e fleet.Event) Tone {
	if e.Warning() {
		return ToneDanger
	}
	return ToneMuted
}
